APP_NAME=QuickCheck
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- DATABASE ----------
# Default: SQLite (tanpa install apa pun, file: database/database.sqlite)
DB_CONNECTION=sqlite

# Untuk MySQL (XAMPP/Laragon): hapus tanda # di bawah, ganti DB_CONNECTION=mysql,
# lalu buat database kosong bernama "quickcheck" lewat phpMyAdmin.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=quickcheck
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# ---------- REGISTRASI ----------
# true  = mahasiswa daftar sendiri, datanya langsung masuk database
# false = NIM harus sudah didaftarkan/diimpor admin
QC_REGISTER_OPEN=true

# ---------- AKUN ADMIN AWAL (dipakai oleh database seeder) ----------
# WAJIB diganti sebelum aplikasi dipakai sungguhan / dikumpulkan.
QC_ADMIN_NAME="Administrator"
QC_ADMIN_USERNAME=admin
QC_ADMIN_PASSWORD=admin123
